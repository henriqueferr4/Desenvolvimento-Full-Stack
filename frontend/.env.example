# Copie para .env (ou .env.local) e ajuste.
# Vazio = usa /api na mesma origem (proxy do Vite / nginx).
VITE_API_URL=
VITE_API_TIMEOUT_MS=15000
# Destino do proxy do Vite em `npm run dev`
VITE_PROXY_TARGET=http://localhost:5000
# true = responde /api com mock/servidores.json (equivale a `npm run dev:mock`)
VITE_USE_MOCK=false
